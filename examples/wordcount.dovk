import "lib/text.dovk" (lines, flatten, count_words)

function usage():
    print("usage: wordcount <file.txt>")

if argument_count() != 1:
    usage()
else:
    path = argument(0)

    if not file_exists(path):
        print("wordcount: cannot open " + path)
    else:
        text = read_file(path)

        print("lines      " + to_string(len(lines(text)) - 1))
        print("words      " + to_string(count_words(flatten(text))))
        print("scalars    " + to_string(len(text)))
