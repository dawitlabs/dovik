function fib(n: Int) -> Int:
    if n < 1:
        return 0

    a = 0
    b = 1
    i = 1

    while i < n:
        next = a + b
        a = b
        b = next
        i = i + 1

    return b

function fib_recursive(n: Int) -> Int:
    if n < 2:
        return n

    return fib_recursive(n - 1) + fib_recursive(n - 2)

function usage():
    print("usage: fib <n>        0 <= n <= 92")

function show_series(upto: Int):
    line = ""
    i = 0

    while i <= upto:
        if i > 0:
            line = line + " "

        line = line + to_string(fib(i))
        i = i + 1

    print(line)

function compare(n: Int):
    start = clock()
    looped = fib(n)
    looped_seconds = clock() - start

    start = clock()
    recursed = fib_recursive(n)
    recursed_seconds = clock() - start

    print("  both agree on  " + to_string(looped) + ": " + to_string(looped == recursed))
    print("  loop           " + to_string(looped_seconds * 1000000.0) + " microseconds")
    print("  recursion      " + to_string(recursed_seconds * 1000000.0) + " microseconds")

if argument_count() != 1:
    usage()
else:
    given = argument(0)
    requested = parse_int(given)

    if requested == none:
        print("fib: not a number: " + given)
        usage()
    else:
        if requested < 0:
            print("fib: n must not be negative")
        else:
            if requested > 92:
                print("fib: fib(93) overflows Int; 92 is the largest that fits")
            else:
                print("fib(" + to_string(requested) + ") = " + to_string(fib(requested)))

                if requested <= 15:
                    show_series(requested)

                if requested <= 30:
                    compare(requested)
